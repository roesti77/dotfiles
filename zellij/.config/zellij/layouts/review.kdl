// Review layout: nvim as the working surface, a shell below it for gates and git.
// Open with:  review  (alias in .zshrc) or
// `zellij action new-tab --layout review`.
//
// No agent pane: since CodeCompanion the agent runs inside nvim as a child
// process (chat buffer + inline diffs), so a second pane would only duplicate
// what the editor already shows.
layout {
    pane size=1 borderless=true {
        plugin location="compact-bar"
    }
    pane split_direction="horizontal" {
        // Read the diff and talk to the agent in the same place: <leader>gdm
        // reviews the whole session (branch vs origin/main), <leader>gdd the
        // working tree, <C-.> toggles the agent chat.
        pane size="70%" command="nvim"
        // Run gates / git / shell.
        pane size="30%"
    }
}
