{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 10,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["sway/language", "idle_inhibitor", "pulseaudio", "network", "battery", "clock", "tray"],

  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "{}"
  },
  "sway/window": {
    "max-length": 70,
    "tooltip": false
  },
  "sway/language": {
    "format": "{short}",
    "tooltip-format": "{long}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "awake",
      "deactivated": "idle"
    }
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "muted",
    "format-bluetooth": "bt {volume}%",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname}  {ipaddr}"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "bat {capacity}%",
    "format-charging": "chg {capacity}%",
    "format-plugged": "ac {capacity}%",
    "tooltip-format": "{timeTo}"
  },
  "clock": {
    "format": "{:%a %d.%m.  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": {
    "spacing": 10
  }
}
