ignore-empty-password
show-failed-attempts

# The two keyboards start on different layouts — us on the Corne, de on the
# built-in one — so which is active decides what a password even types.
show-keyboard-layout
# Home-row mods sometimes send a modifier instead of a letter; a ring that only
# appears while a key is down makes that impossible to notice.
# No bare `indicator` here: that one belongs to swaylock-effects, and upstream
# swaylock rejects it and exits without locking.
indicator-idle-visible

font=Hack
font-size=20
indicator-radius=110
indicator-thickness=10
color=1e1e2e
inside-color=1e1e2e
inside-clear-color=1e1e2e
inside-ver-color=1e1e2e
inside-wrong-color=1e1e2e
ring-color=45475a
ring-clear-color=f9e2af
ring-ver-color=89b4fa
ring-wrong-color=f38ba8
key-hl-color=89b4fa
bs-hl-color=f38ba8
line-color=00000000
separator-color=00000000
text-color=cdd6f4
text-clear-color=1e1e2e
text-ver-color=1e1e2e
text-wrong-color=1e1e2e
