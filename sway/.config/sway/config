set $mod Mod4
set $term ghostty
set $menu fuzzel
set $lock swaylock -f
set $calc com.mitchellh.ghostty.calc

set $hyper Mod4+Control+Mod1+Shift

# MEH (Control+Shift+Mod1) stays unbound on purpose: that one is zellij's modifier.
# Super carries the window manager because nothing under sway competes for it —
# unlike Cmd on the mac, no terminal swallows it. Hyper is the Corne's Tab-hold.

set $base    #1e1e2e
set $surface #313244
set $overlay #6c7086
set $text    #cdd6f4
set $accent  #89b4fa
set $urgent  #f38ba8

client.focused          $accent  $base $text    $accent  $accent
client.focused_inactive $surface $base $text    $surface $surface
client.unfocused        $surface $base $overlay $surface $surface
client.urgent           $urgent  $base $text    $urgent  $urgent

font pango:Hack 11
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
# Both apply only while a workspace holds more than one window, so a lone window
# sits flush instead of showing a strip of background around it.
smart_gaps on
smart_borders on
focus_follows_mouse no
# Floating windows carry no titlebar, so without this they cannot be dragged or
# resized with the mouse at all: Super+left drag moves, Super+right drag resizes.
floating_modifier $mod normal
# Outside the stow tree on purpose: ~/.config/sway is a symlink into a public repo.
# The colour after the mode is the fallback, so a missing file is not an error.
output * background ~/.local/share/wallpaper fill $base

seat seat0 xcursor_theme breeze_cursors 24

# No layout in the type block on purpose. Sway merges type and device settings
# field by field, so a layout here and a variant in a device block can pair into a
# combination that does not exist — twice fixed, twice wrong. Only the shared
# settings live here; every real keyboard names its layout itself.
input type:keyboard {
    xkb_options lv3:ralt_switch
    # The Corne's number layer emits keypad codes, which only resolve to KP_1..KP_9
    # with numlock active.
    xkb_numlock enabled
    repeat_delay 250
    repeat_rate 40
}

# usmac is ours, from .config/xkb/symbols: altgr-intl plus AltGr+u as the umlaut
# dead key, so ä ö ü work with the same gesture as on the mac. The Corne registers
# as four devices, hence four blocks.
input "36125:13370:splitkb.com_Aurora_Corne_rev1" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "36125:13370:splitkb.com_Aurora_Corne_rev1_Keyboard" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "36125:13370:splitkb.com_Aurora_Corne_rev1_Consumer_Control" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "36125:13370:splitkb.com_Aurora_Corne_rev1_System_Control" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "1:1:AT_Translated_Set_2_keyboard" {
    xkb_layout de
    xkb_variant nodeadkeys
}

# By identifier, not by type: the type block below should cover this one, but does
# not in practice — an identifier rule is more specific and matches regardless of
# how libinput classifies the device.
input "1452:613:Apple_Inc._Magic_Trackpad" {
    natural_scroll disabled
    tap enabled
    click_method clickfinger
}

# natural_scroll off is deliberate, not an oversight: this hardware already reports
# its axes the way macOS presents them, so enabling the option inverts them a second
# time and scrolling ends up backwards.
input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
    scroll_method two_finger
    click_method clickfinger
    tap_button_map lrm
    middle_emulation enabled
}

# Output name varies per machine, check with `swaymsg -t get_outputs`.
# Horizontal either way, the finger count decides the distance: three walks the
# workspaces, four jumps between the levels 1-3 and 4-6. Both four-finger directions
# run the same toggle — with two levels there is nowhere else to go.
bindgesture swipe:3:left workspace next_on_output
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:4:left exec ~/.config/sway/scripts/workspace-level
bindgesture swipe:4:right exec ~/.config/sway/scripts/workspace-level

bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

for_window [app_id="$calc"] floating enable, resize set 700 420
for_window [app_id="pavucontrol"] floating enable, resize set 900 600
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Shift+v exec ~/.config/sway/scripts/clip
bindsym $mod+c exec $term --class=$calc -e qalc
bindsym $mod+q kill
bindsym $hyper+l exec $lock
# Parks whatever is focused, so an intrusive window needs no rule of its own.
# Super+z cycles back through everything parked.
bindsym $mod+Shift+z move scratchpad
bindsym $mod+z scratchpad show
bindsym $mod+d exec makoctl dismiss
bindsym $mod+Shift+d exec makoctl dismiss --all
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Control+h resize shrink width 40px
bindsym $mod+Control+j resize grow height 40px
bindsym $mod+Control+k resize shrink height 40px
bindsym $mod+Control+l resize grow width 40px

bindsym $mod+f fullscreen
bindsym $mod+b splith
bindsym $mod+v splitv
# Both lists include the layout they toggle out of — "toggle split" alone cycles
# splith/splitv only, which is a no-op while the container is tabbed.
bindsym $mod+w layout toggle split tabbed
bindsym $mod+s layout toggle split stacking
bindsym $mod+a focus parent
# Flips an existing container; splith/splitv below only set the direction for the
# next window. On g rather than e, which is a home-row mod on the Corne.
bindsym $mod+g layout toggle splitv splith
bindsym $mod+Shift+space floating toggle
# Large without going fullscreen — mostly meant for floating windows.
bindsym $mod+m resize set width 90 ppt height 90 ppt

# Tab switches windows, not workspaces: that is where the cmd+tab reflex lands.
bindsym $mod+Tab exec ~/.config/sway/scripts/winjump
bindsym $mod+grave workspace back_and_forth
bindsym $mod+n workspace next_on_output
bindsym $mod+p workspace prev_on_output

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+KP_1 workspace number 1
bindsym $mod+KP_2 workspace number 2
bindsym $mod+KP_3 workspace number 3
bindsym $mod+KP_4 workspace number 4
bindsym $mod+KP_5 workspace number 5
bindsym $mod+KP_6 workspace number 6
bindsym $mod+KP_7 workspace number 7
bindsym $mod+KP_8 workspace number 8
bindsym $mod+KP_9 workspace number 9

# The Corne has no number row, so moving a container has to work from its keypad
# layer too. Shift flips the numlock keysyms, which is why these are bound under
# the names the keypad actually sends while shifted: KP_1 arrives as KP_End.
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

bindsym $mod+Shift+KP_End move container to workspace number 1
bindsym $mod+Shift+KP_Down move container to workspace number 2
bindsym $mod+Shift+KP_Next move container to workspace number 3
bindsym $mod+Shift+KP_Left move container to workspace number 4
bindsym $mod+Shift+KP_Begin move container to workspace number 5
bindsym $mod+Shift+KP_Right move container to workspace number 6
bindsym $mod+Shift+KP_Home move container to workspace number 7
bindsym $mod+Shift+KP_Up move container to workspace number 8
bindsym $mod+Shift+KP_Prior move container to workspace number 9

bindsym $mod+Shift+s exec grim -g "$(slurp -d)" - | wl-copy
bindsym Print exec grim - | wl-copy

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# Portals read XDG_CURRENT_DESKTOP from the activation environment; without it
# screen sharing in meeting apps picks the wrong backend.
exec dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP=sway WAYLAND_DISPLAY SWAYSOCK DISPLAY

# No keyring exec: kwalletd is dbus-activated through the service file that
# scripts/bootstrap writes, and pam_kwallet already unlocked it at the display
# manager — whichever session started afterwards.

exec_always gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec_always gsettings set org.gnome.desktop.interface gtk-theme 'Breeze-Dark'
exec_always gsettings set org.gnome.desktop.interface icon-theme 'breeze-dark'
# The trailing colon puts every button on the left, the way macOS has them.
exec_always gsettings set org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:'

exec_always ~/.config/sway/scripts/park-vpn
# kanshi applies a display profile when the monitors change — no reload needed, and
# nothing to run on arrival.
exec kanshi

exec wl-paste --watch cliphist store
# A second watcher: the first one only sees text selections, so without this a
# copied image never reaches the history.
exec wl-paste --type image --watch cliphist store
exec waybar
exec mako
exec nm-applet --indicator
# The lock event is what loginctl lock-session triggers; without it that does
# nothing at all.
exec swayidle -w \
    lock '$lock' \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock'
