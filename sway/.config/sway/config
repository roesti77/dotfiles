set $mod Mod4
set $term ghostty
set $menu ~/.config/sway/scripts/launcher
set $lock swaylock -f

# A mode's name is what waybar's sway/mode module prints, so the key hints live in
# the name itself — no second module, and nothing to keep in sync with the bindings
# beyond this line. Kept terse: the text sits in the bar for as long as the mode is.
set $mode_resize "resize   h j k l step · 2 3 4 ratio · v cycle · esc"
set $mode_display "display   a all on · e d panel · r apply · s save · esc"
set $mode_system "system   l lock · s sleep · e exit · r reboot · p off · esc"
set $calc com.mitchellh.ghostty.calc

set $hyper Mod4+Control+Mod1+Shift

# MEH (Control+Shift+Mod1) stays unbound on purpose: that one is zellij's modifier.
# Super carries the window manager because nothing under sway competes for it —
# unlike Cmd on the mac, no terminal swallows it. Hyper is the Corne's Tab-hold.

set $base    #1e1e2e
set $surface #313244
set $overlay #6c7086
set $text    #cdd6f4
set $accent  #89b4fa
set $urgent  #f38ba8

client.focused          $accent  $base $text    $accent  $accent
client.focused_inactive $surface $base $text    $surface $surface
client.unfocused        $surface $base $overlay $surface $surface
client.urgent           $urgent  $base $text    $urgent  $urgent

font pango:Hack 11
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
# Both apply only while a workspace holds more than one window, so a lone window
# sits flush instead of showing a strip of background around it.
smart_gaps on
smart_borders on
focus_follows_mouse no
# Floating windows carry no titlebar, so without this they cannot be dragged or
# resized with the mouse at all: Super+left drag moves, Super+right drag resizes.
floating_modifier $mod normal
# Outside the stow tree on purpose: ~/.config/sway is a symlink into a public repo.
# The colour after the mode is the fallback, so a missing file is not an error.
output * background ~/.local/share/wallpaper fill $base

seat seat0 xcursor_theme breeze_cursors 24

# No layout in the type block on purpose. Sway merges type and device settings
# field by field, so a layout here and a variant in a device block can pair into a
# combination that does not exist — twice fixed, twice wrong. Only the shared
# settings live here; every real keyboard names its layout itself.
input type:keyboard {
    xkb_options lv3:ralt_switch
    # The Corne's number layer emits keypad codes, which only resolve to KP_1..KP_9
    # with numlock active.
    xkb_numlock enabled
    repeat_delay 250
    repeat_rate 40
}

# usmac is ours, from .config/xkb/symbols: altgr-intl plus AltGr+u as the umlaut
# dead key, so ä ö ü work with the same gesture as on the mac. The Corne registers
# as four devices, hence four blocks.
input "36125:13370:splitkb.com_Aurora_Corne_rev1" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "36125:13370:splitkb.com_Aurora_Corne_rev1_Keyboard" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "36125:13370:splitkb.com_Aurora_Corne_rev1_Consumer_Control" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "36125:13370:splitkb.com_Aurora_Corne_rev1_System_Control" {
    xkb_layout usmac
    xkb_variant umlaut
}

input "1:1:AT_Translated_Set_2_keyboard" {
    xkb_layout de
    xkb_variant nodeadkeys
}

# By identifier, not by type: the type block below should cover this one, but does
# not in practice — an identifier rule is more specific and matches regardless of
# how libinput classifies the device.
input "1452:613:Apple_Inc._Magic_Trackpad" {
    natural_scroll disabled
    tap enabled
    click_method clickfinger
}

# natural_scroll off is deliberate, not an oversight: this hardware already reports
# its axes the way macOS presents them, so enabling the option inverts them a second
# time and scrolling ends up backwards.
input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
    scroll_method two_finger
    click_method clickfinger
    tap_button_map lrm
    middle_emulation enabled
}

# Output name varies per machine, check with `swaymsg -t get_outputs`.
# Horizontal either way, the finger count decides the distance: three walks the
# workspaces, four jumps between the levels 1-3 and 4-6. Both four-finger directions
# run the same toggle — with two levels there is nowhere else to go.
bindgesture swipe:3:left workspace next_on_output
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:4:left exec ~/.config/sway/scripts/workspace-level
bindgesture swipe:4:right exec ~/.config/sway/scripts/workspace-level

bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

for_window [app_id="$calc"] floating enable, resize set 700 420
for_window [app_id="pavucontrol"] floating enable, resize set 900 600
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Shift+v exec ~/.config/sway/scripts/clip
bindsym $mod+c exec $term --class=$calc -e qalc
# o is a home-row mod on the Corne, so this one wants Super from the left hand.
# The same script sits on a middle click in the bar, which is the shorter reach
# during a call.
bindsym $mod+o exec ~/.config/sway/scripts/audio-output
bindsym $mod+q kill
bindsym $hyper+l exec $lock
# Parks whatever is focused, so an intrusive window needs no rule of its own.
# Super+z cycles back through everything parked.
bindsym $mod+Shift+z move scratchpad
bindsym $mod+z scratchpad show
bindsym $mod+d exec makoctl dismiss
bindsym $mod+Shift+d exec makoctl dismiss --all
bindsym $mod+Shift+c reload

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# A mode instead of $mod+Control+h/j/k/l: inside one, keys carry no modifier at all,
# and two home-row mods at once is the awkward part on the Corne. Waybar's sway/mode
# module already shows which mode is active.
mode $mode_resize {
    # Same direction keys as focus and move, one step at a time.
    bindsym h resize shrink width 40px
    bindsym j resize grow height 40px
    bindsym k resize shrink height 40px
    bindsym l resize grow width 40px
    bindsym Left resize shrink width 40px
    bindsym Down resize grow height 40px
    bindsym Up resize shrink height 40px
    bindsym Right resize grow width 40px

    # Ratios straight off the digit, which is the denominator. Outside the mode this
    # has to cycle on one key; here each has its own. The keypad twins are what the
    # Corne's number layer actually sends.
    bindsym 2 exec ~/.config/sway/scripts/resize-cycle 50
    bindsym 3 exec ~/.config/sway/scripts/resize-cycle 33
    bindsym 4 exec ~/.config/sway/scripts/resize-cycle 25
    bindsym KP_2 exec ~/.config/sway/scripts/resize-cycle 50
    bindsym KP_3 exec ~/.config/sway/scripts/resize-cycle 33
    bindsym KP_4 exec ~/.config/sway/scripts/resize-cycle 25
    # Two thirds and three quarters have no single digit, so they stay on the cycle.
    bindsym v exec ~/.config/sway/scripts/resize-cycle

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode $mode_resize

# Everything display-related in one place; until now all of it was command line
# only. `output ... enable/disable` is native here, no swaymsg needed.
mode $mode_display {
    # The way back when a profile or a failed mode set left a screen dark.
    bindsym a output * enable
    # The built-in panel, same thing the lid switch does. Two keys rather than
    # `toggle`: toggle only switches something back on when it finds a stored config
    # with enabled == 0, and falls through to "off" otherwise — which it does when no
    # explicit `output eDP-1` line exists, so it only ever switched off.
    # enable/disable rather than power, so the panel's windows move to a screen that
    # is on instead of sitting on a black one; sway-output(5) keeps them for `power`.
    bindsym e output eDP-1 enable
    bindsym d output eDP-1 disable
    # Re-apply the matching kanshi profile; saving deliberately no longer does this.
    bindsym r exec pkill -HUP kanshi

    # Leaves the mode first: a mode's bindings would swallow the keys wofi needs.
    bindsym s mode "default", exec ~/.config/sway/scripts/save-displays-prompt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# Shift, because bare $mod+p is workspace prev_on_output — the pair to $mod+n.
bindsym $mod+Shift+p mode $mode_display

# Everything that ends a session or the machine, behind one key. swaynag confirms
# the three that lose unsaved work in every open window; lock and suspend need no
# confirmation, since neither throws anything away.
mode $mode_system {
    bindsym l mode "default", exec $lock
    # No lock before suspending: swayidle's before-sleep handler below does it.
    bindsym s mode "default", exec systemctl suspend
    bindsym e mode "default", exec swaynag -t warning -m 'Exit sway?' -B 'Exit' 'swaymsg exit'
    bindsym r mode "default", exec swaynag -t warning -m 'Reboot?' -B 'Reboot' 'systemctl reboot'
    bindsym p mode "default", exec swaynag -t warning -m 'Power off?' -B 'Power off' 'systemctl poweroff'

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Escape mode $mode_system

bindsym $mod+f fullscreen
# Direction for the next window: b horizontal, Shift+b vertical — one key position,
# which the Corne has few of. Pressing the same one again takes the split back:
# until a window fills it, the pending split is a container holding only the focused
# window, and layout toggle and resize then act on that instead of the real one.
bindsym $mod+b exec ~/.config/sway/scripts/split-toggle h
bindsym $mod+Shift+b exec ~/.config/sway/scripts/split-toggle v
# Walks the focused window up through 1/4, 1/3, 1/2, 2/3, 3/4 of its container and
# wraps around. Sits where splitv used to, next to g on the Corne.
bindsym $mod+v exec ~/.config/sway/scripts/resize-cycle
# Both lists include the layout they toggle out of — "toggle split" alone cycles
# splith/splitv only, which is a no-op while the container is tabbed. These act on the
# focused container, which is the workspace itself as long as windows are its direct
# children — autotiling used to nest them, leaving these two to catch a subtree.
bindsym $mod+w layout toggle split tabbed
bindsym $mod+s layout toggle split stacking
bindsym $mod+a focus parent
# Flips an existing container; splith/splitv below only set the direction for the
# next window. On g rather than e, which is a home-row mod on the Corne.
bindsym $mod+g layout toggle splitv splith
bindsym $mod+Shift+space floating toggle
# Focus walks the tiling tree, which a floating window is not part of — without this
# the only way back to one is the mouse.
bindsym $mod+Shift+Tab focus mode_toggle
# Large without going fullscreen — mostly meant for floating windows.
bindsym $mod+m resize set width 90 ppt height 90 ppt

# Tab switches windows, not workspaces: that is where the cmd+tab reflex lands.
bindsym $mod+Tab exec ~/.config/sway/scripts/winjump
bindsym $mod+grave workspace back_and_forth
bindsym $mod+n workspace next_on_output
bindsym $mod+p workspace prev_on_output

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+KP_1 workspace number 1
bindsym $mod+KP_2 workspace number 2
bindsym $mod+KP_3 workspace number 3
bindsym $mod+KP_4 workspace number 4
bindsym $mod+KP_5 workspace number 5
bindsym $mod+KP_6 workspace number 6
bindsym $mod+KP_7 workspace number 7
bindsym $mod+KP_8 workspace number 8
bindsym $mod+KP_9 workspace number 9

# The Corne has no number row, so moving a container has to work from its keypad
# layer too. Shift flips the numlock keysyms, which is why these are bound under
# the names the keypad actually sends while shifted: KP_1 arrives as KP_End.
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# A whole workspace to the other monitor — < and > read as directions, and unlike
# the arrow keys they sit on layer 0 of the Corne.
bindsym $mod+Shift+comma move workspace to output left
bindsym $mod+Shift+period move workspace to output right

bindsym $mod+Shift+KP_End move container to workspace number 1
bindsym $mod+Shift+KP_Down move container to workspace number 2
bindsym $mod+Shift+KP_Next move container to workspace number 3
bindsym $mod+Shift+KP_Left move container to workspace number 4
bindsym $mod+Shift+KP_Begin move container to workspace number 5
bindsym $mod+Shift+KP_Right move container to workspace number 6
bindsym $mod+Shift+KP_Home move container to workspace number 7
bindsym $mod+Shift+KP_Up move container to workspace number 8
bindsym $mod+Shift+KP_Prior move container to workspace number 9

# grimshot over grim+slurp by hand: it notifies on success, knows a window as a
# target, and can save as well as copy.
bindsym $mod+Shift+s exec grimshot --notify copy area
bindsym Print exec grimshot --notify copy screen
bindsym Shift+Print exec grimshot --notify save area

# Through swayosd rather than wpctl directly: it changes the same values and draws
# an overlay, which is the point — the bar is the wrong place to look while pressing
# a key.
bindsym --locked XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym --locked XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym --locked XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym --locked XF86MonBrightnessUp exec swayosd-client --brightness raise
bindsym --locked XF86MonBrightnessDown exec swayosd-client --brightness lower
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# Portals read XDG_CURRENT_DESKTOP from the activation environment; without it
# screen sharing in meeting apps picks the wrong backend. waybar.service is chained
# onto it rather than started from its own exec line: sway fires exec entries in
# parallel without waiting, so a separate line would race this one and the bar would
# start without WAYLAND_DISPLAY.
exec dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP=sway WAYLAND_DISPLAY SWAYSOCK DISPLAY && systemctl --user start waybar.service

# No keyring exec: kwalletd is dbus-activated through the service file that
# scripts/bootstrap writes, and pam_kwallet already unlocked it at the display
# manager — whichever session started afterwards.

exec_always gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec_always gsettings set org.gnome.desktop.interface gtk-theme 'Breeze-Dark'
exec_always gsettings set org.gnome.desktop.interface icon-theme 'breeze-dark'
# The trailing colon puts every button on the left, the way macOS has them.
exec_always gsettings set org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:'

exec_always ~/.config/sway/scripts/park-vpn
# kanshi applies a display profile when the monitors change — no reload needed, and
# nothing to run on arrival.
exec kanshi

# The overlay for volume and brightness; the bindings above talk to it.
exec swayosd-server

exec wl-paste --watch cliphist store
# A second watcher: the first one only sees text selections, so without this a
# copied image never reaches the history.
exec wl-paste --type image --watch cliphist store
exec mako
exec nm-applet --indicator
# The lock event is what loginctl lock-session triggers; without it that does
# nothing at all.
exec swayidle -w \
    lock '$lock' \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock'
