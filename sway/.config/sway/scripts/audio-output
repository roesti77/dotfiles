#!/bin/sh
# Rotates through the audio outputs: headset, laptop speakers, dock. Moving the
# default alone would leave anything already playing on the old device, so the
# running streams are moved along with it.
set -eu

sinks=$(pactl list short sinks | awk '{print $2}')
[ -n "$sinks" ] || exit 0

current=$(pactl get-default-sink)
next=$(printf '%s\n' "$sinks" | awk -v cur="$current" '
    { n[NR] = $0 }
    END {
        for (i = 1; i <= NR; i++) if (n[i] == cur) { print n[i % NR + 1]; exit }
        print n[1]
    }')

pactl set-default-sink "$next"

pactl list short sink-inputs | while read -r id _rest; do
    pactl move-sink-input "$id" "$next" >/dev/null 2>&1 || true
done

# The description rather than the sink name: one is readable, the other is
# alsa_output.pci-0000_00_1f.3.analog-stereo.
desc=$(pactl list sinks | awk -v s="$next" '
    $1 == "Name:" { match_ = ($2 == s) }
    match_ && $1 == "Description:" { $1 = ""; sub(/^ /, ""); print; exit }')
notify-send -t 2000 "Audio" "${desc:-$next}"
