#!/bin/sh
# Lays the workspaces out left to right: 1 on the leftmost screen, 2 on the next,
# 3 on the next. Each further group of three follows the same order, so 4 5 6 sit
# where 1 2 3 do. With fewer screens than three the order wraps.
#
# Two commands per workspace, because they do different things: `workspace N output`
# is the rule that steers the workspace from now on, including before it exists,
# while an already-open workspace has to be moved once by hand.
set -eu

# Sorted by x, which is what "left to right" means in sway's layout.
outputs=$(swaymsg -t get_outputs | jq -r '[.[] | select(.active)] | sort_by(.rect.x) | .[].name')
count=$(printf '%s\n' "$outputs" | grep -c . || true)
[ "${count:-0}" -gt 0 ] || exit 0

# Restored at the end: moving a workspace means focusing it first.
current=$(swaymsg -t get_workspaces | jq -r '.[] | select(.focused) | .name' || true)
open=$(swaymsg -t get_workspaces | jq -r '.[].name')

n=1
while [ "$n" -le 9 ]; do
    # Position inside the group of three, wrapped over however many screens there are.
    pos=$(( (n - 1) % 3 % count + 1 ))
    target=$(printf '%s\n' "$outputs" | sed -n "${pos}p")

    swaymsg "workspace $n output \"$target\"" >/dev/null

    if printf '%s\n' "$open" | grep -qx "$n"; then
        swaymsg "workspace $n" >/dev/null
        swaymsg "move workspace to output \"$target\"" >/dev/null
    fi

    n=$((n + 1))
done

[ -z "$current" ] || swaymsg "workspace $current" >/dev/null
