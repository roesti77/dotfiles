#!/bin/sh
# The VPN client has no tray icon and stacks above everything, and neither app_id
# nor class could be guessed — but the title is known. Sway runs no XDG autostart,
# so the client may appear before or after this script: the tree is scanned once,
# then events are watched.
set -eu

title='^Zscaler'

# sway re-runs exec_always on every reload. Killed by command line rather than by
# pid: the loop below runs in a subshell, so $$ is not the process holding the
# subscription, and killing that would leave this one running. The pattern is a
# regex, so it stops before the bracket of -m '["window"]'.
pkill -f 'swaymsg -t subscribe' 2>/dev/null || true

park() {
    while read -r id; do
        swaymsg "[con_id=$id] move scratchpad"
    done
}

swaymsg -t get_tree \
    | jq -r --arg t "$title" 'recurse(.nodes[]?, .floating_nodes[]?)
        | select(.pid? and .name? and (.name | test($t)))
        | .id' \
    | park

swaymsg -t subscribe -m '["window"]' \
    | jq --unbuffered -r --arg t "$title" 'select(.change == "new")
        | .container
        | select(.name != null and (.name | test($t)))
        | .id' \
    | park
