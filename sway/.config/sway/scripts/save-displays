#!/bin/sh
# Writes the current arrangement as a kanshi profile. Arrange the monitors and put
# the workspaces where they belong first, then run this once per location:
#
#     save-displays office
#
# kanshi applies the matching profile on hotplug afterwards — nothing to run on
# arrival. One file per profile, so the sites cannot overwrite each other.
set -eu

name=${1:-}
if [ -z "$name" ]; then
    echo "usage: save-displays <profile-name>" >&2
    exit 2
fi

dir="$HOME/.local/share/kanshi"
mkdir -p "$dir"

# Without at least one file the include glob in ~/.config/kanshi/config stays
# literal and kanshi exits at startup, so keep the placeholder around.
[ -e "$dir/00-placeholder" ] || echo "# Keeps kanshi's include glob matching." >"$dir/00-placeholder"

outputs=$(swaymsg -t get_outputs)
workspaces=$(swaymsg -t get_workspaces)

# Refuse to record an external monitor that is connected but dark. Saving it would
# write `disable` for it, and kanshi would then switch it off on every hotplug — a
# temporary fault becomes permanent. Built-in panels are exempt: those are dark
# because the lid is shut, which is exactly what the profile should capture.
dark=$(printf '%s' "$outputs" | jq -r '
    .[] | select(.active | not) | select(.name | test("^(eDP|LVDS|DSI)") | not) | .name')
if [ -n "$dark" ]; then
    echo "connected but switched off:" >&2
    printf '  %s\n' $dark >&2
    echo "Turn them on (swaymsg output '*' enable) or unplug them, then run again." >&2
    echo "Saving now would record them as permanently disabled." >&2
    exit 1
fi

# A panel without a serial (the built-in one) is matched by connector name — there
# is only ever one of it, and an empty serial makes for a fragile identifier.
# The comma in position is kanshi's syntax; sway writes a space there.
{
    printf 'profile %s {\n' "$name"

    # An inactive built-in panel is written as `disable` — that is the lid switch,
    # and kanshi only applies a profile whose output list covers every CONNECTED
    # output, so leaving it out made lid-closed profiles unusable. An inactive
    # EXTERNAL monitor is refused above instead of being frozen into the profile:
    # recording it as `disable` once turned a temporarily dark screen into a
    # permanently dark one on every hotplug.
    printf '%s' "$outputs" | jq -r '
        .[]
        | (if (.serial // "") == "" then .name else "\(.make) \(.model) \(.serial)" end) as $id
        | if .active then
            "    output \"\($id)\" mode \(.current_mode.width)x\(.current_mode.height)@\(.current_mode.refresh/1000)Hz position \(.rect.x),\(.rect.y) scale \(.scale) transform \(.transform)"
          else
            "    output \"\($id)\" disable"
          end'

    # kanshi does not assign workspaces, so the profile has sway do it. ' is a
    # single quote — writing one literally would end this jq argument.
    printf '%s' "$outputs" | jq -r --argjson ws "$workspaces" '
        . as $outs | $ws[] | . as $w | $outs[] | select(.name == $w.output)
        | (if (.serial // "") == "" then .name else "\(.make) \(.model) \(.serial)" end) as $id
        | "    exec swaymsg \u0027workspace \($w.name) output \"\($id)\"\u0027"'

    printf '}\n'
} >"$dir/$name.tmp"

mv "$dir/$name.tmp" "$dir/$name"
cat "$dir/$name"

# Deliberately no `pkill -HUP kanshi`: reloading makes kanshi apply this profile
# at once, including the workspace exec lines below, which rearranges the desktop
# the moment you only meant to record it. The profile takes effect on the next
# hotplug — or on `pkill -HUP kanshi` by hand, once you want it applied.
