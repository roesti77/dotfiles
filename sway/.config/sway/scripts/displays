#!/bin/sh
# Applies a display layout from whatever is connected, so no monitor name is
# hardcoded. Runs on every reload and when the lid changes.
set -eu

outputs=$(swaymsg -t get_outputs)
externals=$(printf '%s' "$outputs" | jq -r '.[] | select(.name != "eDP-1") | .name' | sort)
count=$(printf '%s' "$externals" | grep -c . || true)

# Left to right in connector order. Physical order may differ; swapping the cables
# is the fix, since sway has no way to know where a monitor actually stands.
x=0
for name in $externals; do
    mode=$(printf '%s' "$outputs" | jq -r --arg n "$name" '
        .[] | select(.name == $n) | .modes
        | sort_by(.width * .height, .refresh) | last
        | "\(.width)x\(.height)@\(.refresh / 1000)Hz"')
    swaymsg output "$name" enable mode "$mode" position "$x" 0
    x=$((x + ${mode%%x*}))
done

# The graphics unit drives two panels, not three — with two externals the laptop
# panel is the one that gives way. With one it fits and stays on, placed to their
# right.
if [ "$count" -ge 2 ]; then
    swaymsg output eDP-1 disable
else
    swaymsg output eDP-1 enable position "$x" 0
fi
