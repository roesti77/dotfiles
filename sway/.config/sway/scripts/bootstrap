#!/bin/sh
# Idempotent: re-run it after a config change or on a second machine.
set -eu

sudo apt install -y \
    sway swayidle swaylock swaybg waybar fuzzel mako-notifier \
    grim slurp wl-clipboard jq brightnessctl playerctl wireplumber pavucontrol \
    network-manager-gnome xdg-desktop-portal-wlr xdg-desktop-portal-kde \
    breeze-gtk-theme fonts-hack qalc

kwalletd=""
for candidate in /usr/bin/kwalletd6 /usr/bin/kwalletd5; do
    if [ -x "$candidate" ]; then
        kwalletd="$candidate"
        break
    fi
done

# KWallet ships no service file for the secret service interface, so libsecret
# clients find no provider until this exists. The alternative is the checkbox in
# System Settings > KDE Wallet, which does the same thing.
if [ -n "$kwalletd" ]; then
    services="$HOME/.local/share/dbus-1/services"
    mkdir -p "$services"
    cat > "$services/org.freedesktop.secrets.service" <<SERVICE
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=$kwalletd
SERVICE
    echo "secret service -> $kwalletd"
else
    echo "WARNING: no kwalletd found, nothing will store credentials"
fi

# The packaged waybar.service hangs off graphical-session.target, which is not up
# at login but gets pulled in later by another service — so it would run a second
# bar next to the one sway's exec starts. The exec is the reliable one.
systemctl --user mask waybar.service >/dev/null

# Electron apps ask the portal for the colour scheme, and xdg-desktop-portal-kde
# answers from kdeglobals — gsettings does not reach them. Without this they stay
# light while GTK apps are dark.
if command -v plasma-apply-colorscheme >/dev/null; then
    plasma-apply-colorscheme BreezeDark >/dev/null 2>&1 || echo "WARNING: could not set the KDE colour scheme"
fi

# The config includes this; without the file sway warns on every start.
touch "${XDG_DATA_HOME:-$HOME/.local/share}/sway-outputs.conf"

command -v ghostty >/dev/null || echo "WARNING: ghostty missing, it has no apt package"
command -v cliphist >/dev/null || echo "WARNING: cliphist missing, no clipboard history"

# -c is required: a positional path is parsed as an IPC command, not a config.
sway --validate -c "$HOME/.config/sway/config"
echo "Done. Log out and pick sway in the session menu."
