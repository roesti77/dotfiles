#!/bin/sh
# Idempotent: re-run it after a config change or on a second machine.
# With --deps it installs the packages and stops there — one list, two entry points,
# so adding a package does not have to be remembered in two files.
set -eu

sudo apt install -y \
    sway swayidle swaylock swaybg waybar wofi mako-notifier \
    grim slurp wl-clipboard jq brightnessctl playerctl wireplumber pavucontrol \
    network-manager-gnome xdg-desktop-portal-wlr xdg-desktop-portal-gtk \
    breeze-gtk-theme fonts-hack qalc curl unzip blueman kanshi grimshot \
    swayosd libglib2.0-bin

[ "${1:-}" = "--deps" ] && exit 0

kwalletd=""
for candidate in /usr/bin/kwalletd6 /usr/bin/kwalletd5; do
    if [ -x "$candidate" ]; then
        kwalletd="$candidate"
        break
    fi
done

# KWallet ships no service file for the secret service interface, so libsecret
# clients find no provider until this exists. The alternative is the checkbox in
# System Settings > KDE Wallet, which does the same thing.
if [ -n "$kwalletd" ]; then
    services="$HOME/.local/share/dbus-1/services"
    mkdir -p "$services"
    cat > "$services/org.freedesktop.secrets.service" <<SERVICE
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=$kwalletd
SERVICE
    echo "secret service -> $kwalletd"
else
    echo "WARNING: no kwalletd found, nothing will store credentials"
fi

# The bar runs as a supervised user unit (.config/systemd/user/waybar.service in
# this package), which overrides the packaged one. Masking it — the earlier fix for
# the duplicate bar — would block that override too, so it has to go. Unmasking
# also has to happen before stow, since the mask is a symlink sitting exactly where
# the unit file belongs.
systemctl --user unmask waybar.service >/dev/null 2>&1 || true
systemctl --user daemon-reload >/dev/null 2>&1 || true

# kanshi expands its include with wordexp: with no profile saved yet the glob stays
# literal, the include fails and kanshi exits at startup — silently, because sway's
# exec reports nothing. This file is not stowed on purpose; stow would symlink the
# directory into the repo and save-displays would write monitor serials into it.
mkdir -p "$HOME/.local/share/kanshi"
if [ ! -e "$HOME/.local/share/kanshi/00-placeholder" ]; then
    echo "# Keeps kanshi's include glob matching. Profiles from save-displays land here." \
        >"$HOME/.local/share/kanshi/00-placeholder"
fi

# The bar renders nerd font glyphs; without them every module shows a box. Not in
# apt, and releases/latest avoids pinning a version that would go stale.
if ! fc-list | grep -qi 'JetBrainsMono Nerd Font'; then
    fonts="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
    mkdir -p "$fonts"
    tmp=$(mktemp -d)
    if curl -fsSL -o "$tmp/font.zip" \
        https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip
    then
        unzip -qo "$tmp/font.zip" -d "$fonts" '*.ttf'
        fc-cache -f >/dev/null
        echo "installed JetBrainsMono Nerd Font"
    else
        echo "WARNING: could not download the nerd font, the bar will show boxes"
    fi
    rm -rf "$tmp"
fi

command -v ghostty >/dev/null || echo "WARNING: ghostty missing, it has no apt package"
command -v cliphist >/dev/null || echo "WARNING: cliphist missing, no clipboard history"

# -c is required: a positional path is parsed as an IPC command, not a config.
sway --validate -c "$HOME/.config/sway/config"
echo "Done. Log out and pick sway in the session menu."
