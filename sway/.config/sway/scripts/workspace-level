#!/bin/sh
# Toggles between the two workspace levels: 1-3 and 4-6, three per level, so the
# offset is three. One script for both directions — from 1 to 4 and from 4 back to 1.
set -eu

num=$(swaymsg -t get_workspaces | jq -r '.[] | select(.focused) | .num')

# Named workspaces report -1; adding three to that lands somewhere arbitrary.
[ "$num" -ge 1 ] 2>/dev/null || exit 0

if [ "$num" -le 3 ]; then
    swaymsg workspace number $((num + 3))
else
    swaymsg workspace number $((num - 3))
fi
