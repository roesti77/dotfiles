#!/bin/sh
# Walks the focused window through a quarter, a third, a half, two thirds and three
# quarters of its container, so a ratio is one keystroke instead of a mouse drag.
#
# The axis is not fixed: stacked windows resize by height, side-by-side ones by
# width, so the parent container's layout decides which command to send. Sway
# hands the space it frees to the siblings on its own.
set -eu

# Ascending, so every press grows the window until it wraps around.
PRESETS="25 33 50 67 75"

# With a percentage, set that outright instead of stepping — the resize mode binds
# the ratios to bare digits, which needs no cycling. Read before `set --` below
# replaces the positional parameters.
want=${1:-}
case "$want" in
    ''|*[!0-9]*) [ -z "$want" ] || { echo "usage: resize-cycle [percent]" >&2; exit 2; } ;;
esac

# A floating or unfocused window has no split parent, so the search can come up
# empty — jq answers "none" there rather than failing on null.
# shellcheck disable=SC2046 # the four fields are plain tokens
set -- $(swaymsg -t get_tree | jq -r '
    [recurse(.nodes[]?, .floating_nodes[]?)
     | select(any(.nodes[]?; .focused == true))] as $parents
    | if ($parents | length) == 0 then "none 0 0 0"
      else ($parents | last) as $p
         | ($p.nodes[] | select(.focused)) as $c
         | (if   $p.layout == "splitv" then "splitv \($c.rect.height) \($p.rect.height)"
            elif $p.layout == "splith" then "splith \($c.rect.width) \($p.rect.width)"
            else "none 0 0" end) + " \($p.nodes | length)"
      end')
layout=${1:-none} own=${2:-0} total=${3:-0} siblings=${4:-0}

# A tabbed or stacking container shows one window at a time, and a window without a
# sibling has nobody to hand the freed space to — neither has a ratio to set.
[ "$layout" != none ] && [ "$total" -gt 0 ] && [ "$siblings" -gt 1 ] || exit 0

# Step to the next preset above the current share and wrap around at the top.
# Comparing against the measured share keeps this stateless: a window resized by
# mouse joins the cycle where it is. The margin is what makes an even split move —
# gaps put it at 49%, and without it the step would land on 50% and look like a no-op.
if [ -n "$want" ]; then
    next=$want
else
    share=$((own * 100 / total))
    next=""
    for preset in $PRESETS; do
        if [ "$preset" -gt $((share + 4)) ]; then
            next=$preset
            break
        fi
    done
    [ -n "$next" ] || next=${PRESETS%% *}
fi

case "$layout" in
    splitv) swaymsg "resize set height $next ppt" >/dev/null ;;
    splith) swaymsg "resize set width $next ppt" >/dev/null ;;
esac
